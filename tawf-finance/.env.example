# ---------------------------------------------------------------------------
# Tawf Finance — Arbitrum Sepolia frontend configuration
# Copy to `.env` and fill in your deployed addresses (never commit `.env`).
# ---------------------------------------------------------------------------

# Arbitrum Sepolia RPC (public fallback shown). For production set this in the
# Vercel project to a dedicated endpoint such as QuickNode:
#   https://<name>.arbitrum-sepolia.quiknode.pro/<key>/
# Never commit the real URL. A VITE_ value is embedded in the public bundle, so
# also restrict the endpoint to the app's domain in the QuickNode dashboard.
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Contract addresses live in src/web3/tokenization.deployments.json.

# Block explorer base URL (defaults to Arbiscan Sepolia)
VITE_EXPLORER=https://sepolia.arbiscan.io

# ---------------------------------------------------------------------------
# Didit KYC (optional)
#   VITE_KYC_ENABLED is a client flag only (no secret).
#   The DIDIT_* values are SERVER-side secrets read by the /api/kyc functions —
#   they are intentionally NOT prefixed with VITE_ so they are never bundled.
# ---------------------------------------------------------------------------
VITE_KYC_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_CALLBACK_URL=https://app.tawf.finance/investor/settings
DIDIT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tokenization (ERC-3643 deposito + sukuk) — SERVER-side secrets for the
# /api/tokenization functions. Not prefixed with VITE_ so they are never
# bundled into the browser. The deposito/sukuk addresses themselves are read
# from src/web3/tokenization.deployments.json (written by DeployTokenization).
# ---------------------------------------------------------------------------

# Demo operator key: holds every on-chain role (mints, funds, anchors reads).
DEMO_OPERATOR_KEY=
# Passcode for admin (issuer/custodian) actions, sent as x-demo-passcode.
DEMO_PASSCODE=

# Arbitrum Sepolia RPC used server-side by the operator. Point it at the same
# dedicated endpoint (for example QuickNode) in the Vercel project settings.
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Tawf Network L3 (chain 7142026) RPC + optional bearer token (reverse proxy).
TAWF_NETWORK_RPC_URL=
TAWF_NETWORK_RPC_TOKEN=

# L3 operator key (holds OPERATOR_ROLE on the SukukLedger). After the sukuk
# subscription closes Active, the close endpoint signs markIssued on the L3
# with this key. If unset, close still succeeds on Arbitrum and returns a
# warning instead of the L3 tx.
TAWF_NETWORK_OPERATOR_KEY=

# Relayer that serves Merkle proofs (GET /leaf, GET /proof).
RELAYER_URL=

# BPRS connector (POST /sync, GET /status) and its API key (x-api-key).
CONNECTOR_URL=
CONNECTOR_API_KEY=

# ReserveLedger address on the Tawf Network L3.
RESERVE_LEDGER=

# SukukLedger address on the Tawf Network L3. The sukuk close endpoint calls
# markIssued here with TAWF_NETWORK_OPERATOR_KEY once the sale goes Active.
SUKUK_LEDGER=
VITE_WALLETCONNECT_PROJECT_ID=   # Reown (WalletConnect) Cloud project id, public. Enables WalletConnect for mobile wallets
