# ---------------------------------------------------------------------------
# Tawf Finance — Arbitrum Sepolia frontend configuration
# Copy to `.env` and fill in your deployed addresses (never commit `.env`).
# ---------------------------------------------------------------------------

# Arbitrum Sepolia RPC (public fallback shown)
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployed contract addresses — read from `forge script script/Deploy.s.sol` output
VITE_DEAL_REGISTRY=0x0000000000000000000000000000000000000000
VITE_RECEIPT_NFT=0x0000000000000000000000000000000000000000
VITE_VAULT=0x0000000000000000000000000000000000000000
VITE_USDC=0x0000000000000000000000000000000000000000

# Block explorer base URL (defaults to Arbiscan Sepolia)
VITE_EXPLORER=https://sepolia.arbiscan.io

# ---------------------------------------------------------------------------
# Didit KYC (optional)
#   VITE_KYC_ENABLED is a client flag only (no secret).
#   The DIDIT_* values are SERVER-side secrets read by the /api/kyc functions —
#   they are intentionally NOT prefixed with VITE_ so they are never bundled.
# ---------------------------------------------------------------------------
VITE_KYC_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_CALLBACK_URL=https://app.tawf.finance/investor/settings
DIDIT_WEBHOOK_SECRET=
