# Solana Network Configuration
# Choose which Solana network to connect to: devnet, testnet, or mainnet
VITE_SOLANA_NETWORK=devnet

# Mainnet RPC Configuration (optional)
# If you need a custom RPC endpoint for mainnet, set it here
# Otherwise the default Solana mainnet RPC will be used
VITE_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Mainnet WebSocket RPC Configuration (optional)
# For real-time updates on mainnet
VITE_MAINNET_WS_RPC=wss://api.mainnet-beta.solana.com

# Notes:
# - devnet and testnet use public RPC endpoints provided by Solana Labs
# - For production, consider using a dedicated RPC provider like:
#   - Helius: https://www.helius.dev/
#   - QuickNode: https://www.quicknode.com/
#   - Triton: https://triton.one/
#   - Alchemy: https://www.alchemy.com/solana

# Supabase (wallet auth via Edge Functions)
VITE_SUPABASE_URL=https://obyyjjuinirrsylxplpc.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
