# Copy to .env.local. Never commit the real values.
# QuickNode Arbitrum Sepolia endpoint (live blocks). Optional: without it the public RPC serves everything.
QUICKNODE_ARB_SEPOLIA_URL=
# Public RPC for the wide backfill ranges.
PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Postgres. Leave empty in dev to use PGlite. In Docker Compose this is set for you.
DATABASE_URL=
DATABASE_SCHEMA=tawf
# Bearer token for the query endpoints (/activity, /governance, /scf/flows, /banks, /sql, /graphql).
PONDER_API_TOKEN=
# Optional: block to start the Beacon, Safe and Timelock sources from (defaults to the series block).
GOVERNANCE_START_BLOCK=
